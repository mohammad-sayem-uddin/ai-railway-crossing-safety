.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv
.venv/
venv
venv/
ENV
ENV/
env
env/
env.bak/
venv.bak/

# --- Testing, Typing, & Linting Caches ---
.pytest_cache
.pytest_cache/
.mypy_cache
.mypy_cache/
.ruff_cache
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# --- Jupyter & Notebook Caches ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# --- Scratch & Pilot Inspection Workspace ---
# (Maintained locally on disk for researcher review; excluded from version control)
scratch
scratch/

# --- Large Raw Media & External Datasets ---
# Original multi-gigabyte recordings and training corpora
data/raw/layer_b/
data/raw/vision/images/
data/raw/vision/labels/
data/raw/audio/
ESC-50-master
ESC-50-master/
Unseen_Video
Unseen_Video/

# Preserve directory anchors in data/
!data/raw/audio/.gitkeep
!data/raw/vision/.gitkeep
!data/interim/.gitkeep
!data/metadata/.gitkeep
!data/splits/.gitkeep

# --- Large Trained Model Weights ---
*.pt
*.pth
*.onnx
*.tflite
*.engine

# Preserve model and experiment directory anchors
!models/.gitkeep
!experiments/**/.gitkeep

# --- Runtime Outputs & Temporary Files ---
outputs/temp_uploads
outputs/temp_uploads/
outputs/video_tests
outputs/video_tests/
outputs/*.mov
outputs/*.mp4
outputs/*.avi
outputs/*.png
outputs/*.jpg
!outputs/.gitkeep

# --- Logs ---
*.log
logs/
