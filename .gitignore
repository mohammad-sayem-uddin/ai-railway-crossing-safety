# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS & IDE
.DS_Store
.commandcode/

# Data (real research data and generated artifacts are not committed)
data/raw/vision/*
!data/raw/vision/.gitkeep
data/raw/audio/*
!data/raw/audio/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/metadata/*
!data/metadata/.gitkeep
data/splits/*
!data/splits/.gitkeep

# Models
models/*
!models/.gitkeep

# Results and generated outputs
results/*
!results/.gitkeep
outputs/*
!outputs/.gitkeep

# Experiment run directories
experiments/*
!experiments/.gitkeep

# Logs
*.log
runs/
*.pt
