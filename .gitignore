# --- Large Raw Media & External Datasets ---
# Original multi-gigabyte recordings and training corpora
data/raw/layer_b/
data/raw/audio/*
!data/raw/audio/.gitkeep
data/raw/vision/*
!data/raw/vision/.gitkeep
data/processed/
ESC-50-master
ESC-50-master/
Unseen_Video
Unseen_Video/

# Preserve directory anchors in data/
!data/raw/audio/.gitkeep
!data/raw/vision/.gitkeep
!data/interim/.gitkeep
!data/metadata/.gitkeep
!data/splits/.gitkeep

# --- Large Trained Model Weights & Training Dumps ---
*.pt
*.pth
*.onnx
*.tflite
*.engine
experiments/**/checkpoints/train_batch*.jpg
experiments/**/checkpoints/val_batch*.jpg
experiments/**/checkpoints/test_batch*.jpg

# Preserve model and experiment directory anchors
!models/.gitkeep
!experiments/**/.gitkeep

# --- Runtime Outputs & Temporary Files ---
outputs/temp_uploads
outputs/temp_uploads/
outputs/video_tests
outputs/video_tests/
outputs/*.mov
outputs/*.mp4
outputs/*.avi
outputs/*.png
outputs/*.jpg
!outputs/.gitkeep

# --- Logs ---
*.log
logs/

# ==============================================================================
# Repository maintenance additions (2026-11-08)
# Narrow additions only. Evidence-bearing trees (results/, experiments/,
# docs/generated/, data/ground_truth/, configs/) remain deliberately tracked.
# Derived experiment caches under data/cache/ and results/experiments/cache/
# are intentional versioned artifacts and are NOT ignored.
# ==============================================================================

