# Railway Level-Crossing Detection Framework - Environment Variables
# Copy this file to .env and replace placeholder values with your actual configuration.
# DO NOT COMMIT .env TO VERSION CONTROL.

# AI-Assisted Ground Truth Annotation (Optional offline drafting assistance)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro

# Logging & Environment
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
